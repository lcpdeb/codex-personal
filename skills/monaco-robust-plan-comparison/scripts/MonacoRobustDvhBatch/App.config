<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ManifestPath" value="" />
    <!-- Set the DVH output directory. Program.cs writes each DVH directly here with the patient ID in its filename. -->
    <add key="OutputRootDirectory" value="" />
    <add key="NormalPlanName" value="" />
    <add key="RobustPlanName" value="" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
